[Unit]
Description=Eneby BT Bridge — internet radio to Bluetooth speaker
After=network-online.target bluetooth.target pulseaudio.service
Wants=network-online.target

[Service]
Type=simple
User=hasseberg
Environment=PORT=80
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
WorkingDirectory=/home/hasseberg/EnebyBridge/pi
ExecStart=/home/hasseberg/EnebyBridge/pi/venv/bin/python3 /home/hasseberg/EnebyBridge/pi/eneby_bridge.py
Restart=on-failure
RestartSec=5

# Allow binding to port 80 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
